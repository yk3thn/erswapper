<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ERSwapper</RootNamespace>
    <AssemblyName>ERSwapper</AssemblyName>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>ERSwapper.ico</ApplicationIcon>
    <Version>1.0.1</Version>
    <AssemblyVersion>1.0.1.0</AssemblyVersion>
    <FileVersion>1.0.1.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="ERSwapper.Core" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ERSwapper.Core\ERSwapper.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="ERSwapper.ico" />
  </ItemGroup>

  <!-- Everything the end user needs ships in the output folder: the item catalogue, the .resS
       signatures that locate texture data, pre-generated thumbnails, and the texture converter.
       Nothing here has to be configured by hand. -->
  <ItemGroup>
    <None Remove="Config\**\*" />
    <Content Include="Config\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <None Update="texconv.exe">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>

